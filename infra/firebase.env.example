# Firebase Admin credentials for FCM.
# Copy this file to infra/firebase.env (ignored by git) and fill it in.
# Generate the base64 value from a downloaded service-account JSON file:
#   base64 -w0 firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-service-account-json
