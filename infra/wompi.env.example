# Local Wompi payment gateway credentials.
#
# Copy this file to "wompi.env" (same folder) and fill in the real values
# from your Wompi merchant dashboard.
#
# This file is consumed ONLY by infra/bootstrap/08-secrets.sh. It is never
# read by the application directly and never committed (see .gitignore).

WOMPI_CLIENT_ID=change-me
WOMPI_CLIENT_SECRET=change-me
