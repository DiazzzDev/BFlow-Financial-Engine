PORT=8080
BASE_URL=http://localhost:8080

# PostgreSQL Database Configuration (Local Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bflow_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_SSL_MODE=disable

# Google OAuth2 Configuration
# Get these credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# AWS General
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# Branding
# Image/logo used in emails, receipts, etc.
LOGO_URL=

FRONTEND_URL=https://www.bflow-studio.com

# AWS Cognito (Auth)
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool-id
COGNITO_USER_POOL_ID=your-user-pool-id

# Wompi (Payments)
# Get these credentials from your Wompi merchant dashboard
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
WOMPI_APP_ID=
WOMPI_API_SECRET=

# AWS S3 (Receipt storage)
S3_BUCKET=your-s3-bucket-name

# Receipt OCR pipeline (SQS + SNS + Textract)
RECEIPT_OCR_REQUESTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/your-ocr-requests-queue
RECEIPT_OCR_RESULTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/your-ocr-results-queue
RECEIPT_OCR_RESULTS_TOPIC_ARN=arn:aws:sns:us-east-1:your-account-id:your-ocr-results-topic
TEXTRACT_SNS_ROLE_ARN=arn:aws:iam::your-account-id:role/your-textract-sns-role
