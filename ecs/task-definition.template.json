{
  "family": "${ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024",

  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",

  "containerDefinitions": [
    {
      "name": "bflow-backend",

      "image": "placeholder",

      "essential": true,

      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],

      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "JAVA_TOOL_OPTIONS",
          "value": "${JAVA_TOOL_OPTIONS}"
        },
        {
          "name": "OTEL_SERVICE_NAME",
          "value": "${OTEL_SERVICE_NAME}"
        },
        {
          "name": "OTEL_RESOURCE_ATTRIBUTES",
          "value": "${OTEL_RESOURCE_ATTRIBUTES}"
        },
        {
          "name": "OTEL_TRACES_EXPORTER",
          "value": "${OTEL_TRACES_EXPORTER}"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_TRACES_PROTOCOL",
          "value": "${OTEL_EXPORTER_OTLP_TRACES_PROTOCOL}"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
          "value": "${OTEL_EXPORTER_OTLP_TRACES_ENDPOINT}"
        },
        {
          "name": "OTEL_METRICS_EXPORTER",
          "value": "${OTEL_METRICS_EXPORTER}"
        },
        {
          "name": "OTEL_LOGS_EXPORTER",
          "value": "${OTEL_LOGS_EXPORTER}"
        },
        {
          "name": "OTEL_AWS_APPLICATION_SIGNALS_ENABLED",
          "value": "${OTEL_AWS_APPLICATION_SIGNALS_ENABLED}"
        },
        {
          "name": "OTEL_TRACES_SAMPLER",
          "value": "${OTEL_TRACES_SAMPLER}"
        },
        {
          "name": "OTEL_TRACES_SAMPLER_ARG",
          "value": "${OTEL_TRACES_SAMPLER_ARG}"
        },
        {
          "name": "OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED",
          "value": "${OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED}"
        },
        {
          "name": "OTEL_INSTRUMENTATION_SANITIZATION_URL_EXPERIMENTAL_SENSITIVE_QUERY_PARAMETERS",
          "value": "${OTEL_INSTRUMENTATION_SANITIZATION_URL_EXPERIMENTAL_SENSITIVE_QUERY_PARAMETERS}"
        },
        {
          "name": "DB_SSL_MODE",
          "value": "require"
        },
        {
          "name": "COGNITO_ISSUER_URI",
          "value": "${COGNITO_ISSUER_URI}"
        },
        {
          "name": "COGNITO_USER_POOL_ID",
          "value": "${COGNITO_USER_POOL_ID}"
        },
        {
          "name": "AWS_SES_FROM_EMAIL",
          "value": "noreply@bflow-studio.com"
        },
        {
          "name": "LOGO_URL",
          "value": "https://res.cloudinary.com/dcvq5i0py/image/upload/v1785175658/Bflow-logo-v1_apjjqh.png"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://www.bflow-studio.com/"
        },
        {
          "name": "BASE_URL",
          "value": "https://api.bflow-studio.com"
        },
        {
          "name": "FIREBASE_ENABLED",
          "value": "${FIREBASE_ENABLED}"
        },
        {
          "name": "S3_BUCKET",
          "value": "${S3_BUCKET}"
        },
        {
          "name": "RECEIPT_OCR_REQUESTS_QUEUE_URL",
          "value": "${RECEIPT_OCR_REQUESTS_QUEUE_URL}"
        },
        {
          "name": "RECEIPT_OCR_RESULTS_QUEUE_URL",
          "value": "${RECEIPT_OCR_RESULTS_QUEUE_URL}"
        },
        {
          "name": "RECEIPT_OCR_RESULTS_TOPIC_ARN",
          "value": "${RECEIPT_OCR_RESULTS_TOPIC_ARN}"
        },
        {
          "name": "TEXTRACT_SNS_ROLE_ARN",
          "value": "${TEXTRACT_SNS_ROLE_ARN}"
        }
      ],

      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "${RDS_SECRET_ARN}:DB_HOST::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "${RDS_SECRET_ARN}:DB_PORT::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "${RDS_SECRET_ARN}:DB_NAME::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "${RDS_SECRET_ARN}:DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${RDS_SECRET_ARN}:DB_PASSWORD::"
        },
        {
          "name": "WOMPI_CLIENT_ID",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_CLIENT_ID::"
        },
        {
          "name": "WOMPI_CLIENT_SECRET",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_CLIENT_SECRET::"
        },
        {
          "name": "WOMPI_APP_ID",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_APP_ID::"
        },
        {
          "name": "WOMPI_API_SECRET",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_API_SECRET::"
        },
        {
          "name": "FIREBASE_PROJECT_ID",
          "valueFrom": "${FIREBASE_SECRET_ARN}:FIREBASE_PROJECT_ID::"
        },
        {
          "name": "FIREBASE_SERVICE_ACCOUNT_JSON_BASE64",
          "valueFrom": "${FIREBASE_SECRET_ARN}:FIREBASE_SERVICE_ACCOUNT_JSON_BASE64::"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",

        "options": {
          "awslogs-group": "${CLOUDWATCH_LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
