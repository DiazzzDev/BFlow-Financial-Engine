{
  "family": "${ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024",

  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",

  "containerDefinitions": [
    {
      "name": "bflow-backend",

      "image": "placeholder",

      "essential": true,

      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],

      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "DB_SSL_MODE",
          "value": "require"
        },
        {
          "name": "COGNITO_ISSUER_URI",
          "value": "${COGNITO_ISSUER_URI}"
        },
        {
          "name": "COGNITO_USER_POOL_ID",
          "value": "${COGNITO_USER_POOL_ID}"
        },
        {
          "name": "AWS_SES_FROM_EMAIL",
          "value": "noreply@bflow-studio.com"
        },
        {
          "name": "LOGO_URL",
          "value": "https://res.cloudinary.com/dmv1q774l/image/upload/v1778910438/Bflow-logo-v1_yq5uyb.png"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://www.bflow-studio.com/"
        },
        {
          "name": "BASE_URL",
          "value": "https://api.bflow-studio.com"
        },
        {
          "name": "S3_BUCKET",
          "value": "${S3_BUCKET}"
        },
        {
          "name": "RECEIPT_OCR_REQUESTS_QUEUE_URL",
          "value": "${RECEIPT_OCR_REQUESTS_QUEUE_URL}"
        },
        {
          "name": "RECEIPT_OCR_RESULTS_QUEUE_URL",
          "value": "${RECEIPT_OCR_RESULTS_QUEUE_URL}"
        },
        {
          "name": "RECEIPT_OCR_RESULTS_TOPIC_ARN",
          "value": "${RECEIPT_OCR_RESULTS_TOPIC_ARN}"
        },
        {
          "name": "TEXTRACT_SNS_ROLE_ARN",
          "value": "${TEXTRACT_SNS_ROLE_ARN}"
        }
      ],

      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "${RDS_SECRET_ARN}:DB_HOST::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "${RDS_SECRET_ARN}:DB_PORT::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "${RDS_SECRET_ARN}:DB_NAME::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "${RDS_SECRET_ARN}:DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${RDS_SECRET_ARN}:DB_PASSWORD::"
        },
        {
          "name": "WOMPI_CLIENT_ID",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_CLIENT_ID::"
        },
        {
          "name": "WOMPI_CLIENT_SECRET",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_CLIENT_SECRET::"
        },
        {
          "name": "WOMPI_APP_ID",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_APP_ID::"
        },
        {
          "name": "WOMPI_API_SECRET",
          "valueFrom": "${WOMPI_SECRET_ARN}:WOMPI_API_SECRET::"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",

        "options": {
          "awslogs-group": "${CLOUDWATCH_LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
